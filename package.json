{
  "name": "dj-visualizer",
  "version": "1.5.1",
  "description": "Audio-reactive fractal & abstract visualizer for external display (Mac)",
  "main": "main.js",
  "author": {
    "name": "Dj LuZa",
    "email": "info@djluza.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.djvisualizer.app",
    "productName": "DJ Visualizer",
    "copyright": "© Dj LuZa",
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg",
      "icon": "build/icon.icns",
      "identity": null
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "svg/**/*",
      "models/**/*",
      "scripts/fbx2animglb.py",
      "scripts/fbx2modelglb.py"
    ],
    "asarUnpack": [
      "scripts/*.py"
    ]
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.0"
  }
}
